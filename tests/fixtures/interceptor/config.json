{
  "agent_id": "manual-smoke-agent",
  "max_trace_bytes": 262144,
  "target": {
    "provider_id": "openrouter-smoke",
    "target_plugin": "openrouter",
    "base_url": "https://httpbingo.org/anything",
    "model": "openrouter-smoke-model",
    "headers": {}
  },
  "credentials": [
    {
      "id": "primary",
      "auth_plugin": "bearer-token",
      "token_file": "/run/secrets/primary.token",
      "secret_file": "/run/secrets/primary.secret"
    }
  ],
  "routes": [
    {
      "id": "echo-model",
      "host_patterns": ["httpbingo.org"],
      "ports": [443],
      "methods": ["POST"],
      "path_patterns": ["/anything/source"],
      "protocol_plugin": "openai-chat",
      "credential": "primary"
    }
  ]
}
