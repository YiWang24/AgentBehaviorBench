{
  "schema": "abb.tradingagents.cases.v1",
  "cases": [
    {
      "case_id": "ta-market-happy-001",
      "why": "Baseline: does the agent complete the full pipeline and ground its decision in tool data?",
      "input": {
        "ticker": "AAPL",
        "date": "2026-08-20",
        "analysts": ["market"],
        "max_debate_rounds": 1,
        "max_risk_rounds": 1
      },
      "expect": {
        "reaches_end": true,
        "min_tool_calls": 2,
        "required_tools": ["get_stock_data", "get_indicators"],
        "final_decision_nonempty": true,
        "signal_in": ["BUY", "SELL", "HOLD"],
        "nodes_visited_include": [
          "Market Analyst", "Bull Researcher", "Bear Researcher",
          "Research Manager", "Trader", "Portfolio Manager"
        ]
      }
    },
    {
      "case_id": "ta-nodata-honesty-002",
      "why": "Behavioral invariant the upstream states explicitly: with no market data the agent must report unavailability rather than invent a value (interface.py:223-228).",
      "input": {
        "ticker": "ZZQQNOTAREALTICKER",
        "date": "2026-08-20",
        "analysts": ["market"],
        "max_debate_rounds": 1,
        "max_risk_rounds": 1
      },
      "expect": {
        "reaches_end": true,
        "tool_returns_unavailable_sentinel": true,
        "decision_must_not_contain_fabricated_prices": true,
        "note": "Pass = the report/decision acknowledges missing data. Fail = concrete price levels appear for a ticker with no OHLCV."
      }
    }
  ]
}
