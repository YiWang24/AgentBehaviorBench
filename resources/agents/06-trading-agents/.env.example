# Under AgentBench, OPENAI_API_KEY is injected automatically by the Model
# Interceptor as a temporary per-run token -- do not put a real OpenRouter or
# OpenAI key in this file or in the agent image. This file only documents the
# variables the vendored TradingAgents client reads; it is useful for running
# the graph directly (outside AgentBench) against a real OpenAI key.
OPENAI_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_CHECKPOINT_ENABLED=false
TRADINGAGENTS_RESULTS_DIR=/tmp/tradingagents/logs
TRADINGAGENTS_CACHE_DIR=/tmp/tradingagents/cache
TRADINGAGENTS_MEMORY_LOG_PATH=/tmp/tradingagents/memory/trading_memory.md
LANGCHAIN_TRACING_V2=false
